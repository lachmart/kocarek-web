{block content}
<div class="bg-white">
    <div class="pt-6">
        <!-- Image gallery -->
        <div class="mx-auto mt-6 max-w-2xl sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
            <div class="aspect-h-4 aspect-w-3 hidden overflow-hidden rounded-lg lg:block">
                <img src="/images/svitici_kocarek03.jpg" alt="Vánoční barvy."
                     class="h-full w-full object-cover object-center">
            </div>
            <div class="hidden lg:grid lg:grid-cols-1 lg:gap-y-8">
                <div class="aspect-h-2 aspect-w-3 overflow-hidden rounded-lg">
                    <img src="/images/rolled.jpg" alt="Model wearing plain gray basic tee."
                         class="h-full w-full object-cover object-center">
                </div>
                <div class="aspect-h-2 aspect-w-3 overflow-hidden rounded-lg">
                    <img src="/images/white detail.jpg" alt="" class="h-full w-full object-cover object-center">
                </div>
            </div>
            <div class="aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
                <img src="/images/svitici_kocarek07.jpg" alt="" class="h-full w-full object-cover object-center">
            </div>
        </div>

        <!-- Product info -->
        <div class="mx-auto max-w-2xl px-4 pb-16 pt-10 sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:grid-rows-[auto,auto,1fr] lg:gap-x-8 lg:px-8 lg:pb-24 lg:pt-16">
            <div class="lg:col-span-2 lg:border-r lg:border-gray-200 lg:pr-8">
                <h1 class="text-2xl font-bold tracking-tight text-gray-900 sm:text-3xl">Svítící kočárek - LED pásek</h1>
            </div>
            {*            <div class="mt-4 lg:row-span-3 lg:mt-0">*}
            {*                <p class="text-3xl tracking-tight text-gray-900">1299 Kč</p>*}
            {*                <p class="text-3xl tracking-tight text-gray-400 ">dostupné od 2. listopadu 2023</p>*}
            {*            </div>*}
            <!-- Options -->
            <div class="mt-4 lg:row-span-3 lg:mt-0">
                <p class="text-3xl tracking-tight text-gray-900">1299 Kč </p>
                <p class="tracking-tight text-gray-400 ">Plaba převodem, platební údaje posíláme e-mailem.<br> Cena je konečná, včetně dopravy zásilkovnou.</p>
                {if $productWhite->getStock() || $productBlack->getStock()}
                <div n:foreach="$flashes as $flash" class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative" role="alert"><strong class="font-bold">{$flash->message}</strong></div>
                <form class="mt-10" n:name="orderForm">
                    <!-- Colors -->
                    <div>
                        <h3 class="text-sm font-medium text-gray-900">Barva *</h3>

                        <fieldset class="mt-4">
                            <legend class="sr-only">Vyberte barvu</legend>
                            <div class="flex items-center space-x-3">
                                {foreach $form[color]->getItems() as $key => $label}
                                    <!--
                                    Active and Checked: "ring ring-offset-1"
                                    Not Active and Checked: "ring-2"
                                    -->
                                    <label n:name="color:$key"
                                            class="relative -m-0.5 flex cursor-pointer items-center justify-center rounded-full p-0.5 focus:outline-none ring-gray-400 {if $iterator->getCounter() === 1}ring ring-offset-1{/if}">
                                        <input type="radio" n:name="color:$key" class="sr-only color-choice"
                                               aria-labelledby="color-choice-{$key}-label" {if $iterator->getCounter() === 1}checked{/if}>
                                        <span id="color-choice-{$key}-label" class="sr-only">{$label}</span>
                                        <span aria-hidden="true"
                                              class="h-8 w-8 {if $key === 1}bg-white{elseif $key === 2}bg-gray-900{/if} rounded-full border border-black border-opacity-10"></span>
                                    </label>
                                {/foreach}
                            </div>
                        </fieldset>
                    </div>

                    <!-- Sizes -->
                    <div class="mt-10">
                        <div class="flex items-center justify-between">
                            <h3 class="text-sm font-medium text-gray-900">Velikost *</h3>
                            <a n:href="Home:default#faq"
                                    class="text-sm font-medium text-indigo-600 hover:text-indigo-500" target="_blank">Jak
                                vybrat?</a>
                        </div>

                        <fieldset class="mt-4">
                            <legend class="sr-only">Vyberte velikost</legend>
                            <div class="grid grid-cols-4 gap-4 sm:grid-cols-8 lg:grid-cols-4">
                                {foreach $form[size]->getItems() as $key => $label}
                                    <!-- Active: "ring-2 ring-indigo-500" -->
                                    <label n:name="size:$key"
                                            class="group relative flex items-center justify-center rounded-md border py-3 px-4 text-sm font-medium uppercase hover:bg-gray-50 focus:outline-none sm:flex-1 sm:py-6 cursor-pointer bg-white text-gray-900 shadow-sm {if $iterator->getCounter() === 1}ring-2 ring-indigo-500{/if}">
                                        <input n:name="size:$key" type="radio" class="sr-only  size-choice"
                                                aria-labelledby="size-choice-{$key}-label" {if $iterator->getCounter() === 1}checked{/if}>
                                        <span id="size-choice-{$key}-label">{$label}</span>
                                    </label>
                                {/foreach}
                            </div>
                        </fieldset>
                    </div>

                    <div class="mt-10">
                            <div>
                                <label for="name" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Jméno *</label>
                                <input type="text" n:name="name" id="name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="Jméno Příjmení">
                            </div>
                            <div>
                                <label for="email" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">E-mail *</label>
                                <input type="text" n:name="email" id="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="neco@domena.cz">
                            </div>
                            <div>
                                <label for="phone" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Telefon</label>
                                <input type="text" n:name="phone" id="phone" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="123456789">
                            </div>
                            <div>
                                <label for="packetery" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Zásilkovna *</label>
                                <input onclick="Packeta.Widget.pick(packetaApiKey, showSelectedPickupPoint, packetaOptions)" type="text" n:name="packetery" id="packetery" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-primary-600 focus:border-primary-600 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="Kliknutím vyber">
                            </div>
                            <div class="sm:col-span-2">
                                <label for="description" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Poznámka</label>
                                <textarea n:name="note" rows="5" class="block p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-primary-500 focus:border-primary-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-primary-500 dark:focus:border-primary-500" placeholder="Místo pro poznámku..."></textarea>
                            </div>
                    </div>

                    <button type="submit" n:name="submit"
                            class="mt-10 flex w-full items-center justify-center rounded-md border border-transparent bg-indigo-600 px-8 py-3 text-base font-medium text-white hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
                        Závazně objednat
                    </button>
                </form>
            {else}
                <div class="mt-4 lg:row-span-3 lg:mt-0">
                    <p class="text-3xl tracking-tight text-gray-900">To bylo rychlé!</p>
                    <p class="text-3xl tracking-tight text-gray-400 ">Další pásky teď nemáme na skladě. </p>
                </div>
            {/if}
            </div>

            <div class="py-10 lg:col-span-2 lg:col-start-1 lg:border-r lg:border-gray-200 lg:pb-16 lg:pr-8 lg:pt-6">
                <!-- Description and details -->
                <div>
                    <h3 class="sr-only">Popis</h3>

                    <div class="space-y-6">
                        <p class="text-base text-gray-900">Pásek, který se připne kolem kočárku. Má 4 stupně intenzity
                            světla a několik statických i pohyblivých režimů, které můžete libovolně přepínat. Zlepšuje
                            vaši viditelnost na chodnících, přechodech i cyklostezkách. Postíví vám ve sklepě nebo v
                            temné uličce.</p>
                    </div>
                </div>

                <div class="mt-10">
                    <h3 class="text-sm font-medium text-gray-900">Výhody</h3>

                    <div class="mt-4">
                        <ul role="list" class="list-disc space-y-2 pl-4 text-sm">
                            <li class="text-gray-400"><span
                                        class="text-gray-600">lepší viditelnost, bezpečnost a styl</span></li>
                            <li class="text-gray-400"><span class="text-gray-600">4 stupně intenzity</span></li>
                            <li class="text-gray-400"><span class="text-gray-600">barevné pohyblivé efekty</span></li>
                            <li class="text-gray-400"><span class="text-gray-600">usb c</span></li>
                            <li class="text-gray-400"><span
                                        class="text-gray-600">paměť posledního použitého režimu</span></li>
                        </ul>
                    </div>
                </div>

                <div class="mt-10">
                    <h3 class="text-sm font-medium text-gray-900">V balení</h3>

                    <div class="mt-4">
                        <ul role="list" class="list-disc space-y-2 pl-4 text-sm">
                            <li class="text-gray-400"><span
                                        class="text-gray-600">bílý, nebo černý pásek vyrobený na míru</span></li>
                            <li class="text-gray-400"><span class="text-gray-600">2x spojovací díl (navržen jako nejslabší článek, který povolí dřív než citlivé komponenty)</span>
                            </li>
                            <li class="text-gray-400"><span class="text-gray-600">kabel pro připojení k power bance (usb A -> usb c)</span>
                            </li>
                        </ul>
                    </div>
                </div>

                {* <div class="mt-10">
                <h2 class="text-sm font-medium text-gray-900">Podrobný popis</h2>

                <div class="mt-4 space-y-6">
                    <p class="text-sm text-gray-600">The 6-Pack includes two black, two white, and two heather gray Basic Tees. Sign up for our subscription service and be the first to get new, exciting colors, like our upcoming &quot;Charcoal Gray&quot; limited release.</p>
                </div> *}
            </div>
        </div>
    </div>

    <!-- Image gallery -->
    <div class="mx-auto mt-6 max-w-2xl sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek06.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek02.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/pafca.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
    </div>
    <div class="mx-auto max-w-2xl lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/wd2.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/bd3.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/wd3.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
    </div>
    <div class="mx-auto mt-6 max-w-2xl sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/bd2.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/br.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/wd.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
    </div>
    <div class="mx-auto max-w-2xl lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek13.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek15.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class=" mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek16.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
    </div>
    <div class="mx-auto max-w-2xl sm:px-6 lg:grid lg:max-w-7xl lg:grid-cols-3 lg:gap-x-8 lg:px-8">
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek18.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek05.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
        <div class="mt-6 aspect-h-5 aspect-w-4 lg:aspect-h-4 lg:aspect-w-3 sm:overflow-hidden sm:rounded-lg">
            <img src="/images/svitici_kocarek19.jpg" alt="" class="h-full w-full object-cover object-center">
        </div>
    </div>
</div>
</div>

<script>
    // Get all radio input elements with the class "color-choice"
    var radioInputs = document.querySelectorAll('.color-choice');

    // Add a change event listener to each radio input
    radioInputs.forEach(function (input) {
        input.addEventListener('change', function () {
            // Get the label element associated with the clicked input
            var label = this.parentNode;

            // Remove the "ring" class from all labels
            radioInputs.forEach(function (radioInput) {
                radioInput.parentNode.classList.remove('ring', 'ring-offset-1');
            });

            // Add the "ring" class to the clicked label
            label.classList.add('ring', 'ring-offset-1');
        });
    });
</script>
<script>
    // Get all radio input elements with the name "size-choice"
    var sizeRadioInputs = document.querySelectorAll('.size-choice');

    // Add a change event listener to each radio input
    sizeRadioInputs.forEach(function (input) {
        input.addEventListener('change', function () {
            // Get the label element associated with the clicked input
            var label = this.parentNode;

            // Remove the "ring-2 ring-indigo-500" class from all labels
            sizeRadioInputs.forEach(function (radioInput) {
                radioInput.parentNode.classList.remove('ring-2', 'ring-indigo-500');
            });

            // Add the "ring-2 ring-indigo-500" class to the clicked label
            label.classList.add('ring-2', 'ring-indigo-500');
        });
    });
</script>
<script src="https://widget.packeta.com/v6/www/js/library.js"></script>

<script>
    const packetaApiKey = '51df884ddb0b64e4';

    const packetaOptions = {
        country: "cz",
        valueFormat: "\"Packeta\",id,carrierId,carrierPickupPointId,name,city,street"
    };

    function showSelectedPickupPoint(point) {
        // Add here an action on pickup point selection
        const saveElement = document.querySelector("#packetery");
        saveElement.value = '';
        if (point) {
            saveElement.value = point.formatedValue;
        };
    }


</script>