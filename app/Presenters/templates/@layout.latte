<!doctype html>
<html lang="cs">
<head>

    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        // Set default consent to 'denied' as a placeholder
        // Determine actual values based on your own requirements
        gtag('consent', 'default', {
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'analytics_storage': 'denied'
        });
    </script>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FQCK2FFKY2"></script>
    <script>
        window.dataLayer = window.dataLayer || [];

        function gtag() {
            dataLayer.push(arguments);
        }

        gtag('js', new Date());
        gtag('config', 'G-FQCK2FFKY2');
    </script>
    <meta charset="UTF-8">
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description" content="Pásek, který obmotáš kolem korbičky kočárku a zapojíš do power banky. Svítí, bliká a je
                prostě vidět. Pomáhá všem, kteří chodí s kočárkem ve tmě. Prosvítí tmavý sklep, upozorní přijíždějící
                auta a přiláká pozornost kolemjdoucích.">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Martin Lach">
    <meta property="og:image" content="https://www.sviticikocarek.cz/images/hero.png">
    <meta name="twitter:card" content="summary">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <link href="../dist/cookiesconsent.theme-dark.css" rel="stylesheet">
    <link href="../dist/cookiesconsent.min.css" rel="stylesheet">
    <link href="../dist/output.css?v=2" rel="stylesheet">
    <title>{ifset title}{include title|stripHtml} | {/ifset}Svítící kočárek</title>
</head>

<body>
<header>
    <nav class="bg-white border-gray-200 px-4 lg:px-6 py-2.5 dark:bg-gray-800">
        <div class="flex flex-wrap justify-between items-center mx-auto max-w-screen-xl">
            <a href="/" class="flex items-center">
                <img src="/images/logo.png" class="mr-3 h-6 sm:h-9" alt="Svitici kocarek Logo"/>
                <span class="self-center text-xl font-semibold whitespace-nowrap dark:text-white">Svítící kočárek</span>
            </a>
            <div class="flex items-center lg:order-2">
                <button data-collapse-toggle="mobile-menu-2" type="button"
                        class="inline-flex items-center p-2 ml-1 text-sm text-gray-500 rounded-lg lg:hidden hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-gray-200 dark:text-gray-400 dark:hover:bg-gray-700 dark:focus:ring-gray-600"
                        aria-controls="mobile-menu-2">
                    <span class="sr-only">Otevřít menu</span>
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                              d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z"
                              clip-rule="evenodd"></path>
                    </svg>
                    <svg class="hidden w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                         xmlns="http://www.w3.org/2000/svg">
                        <path fill-rule="evenodd"
                              d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                              clip-rule="evenodd"></path>
                    </svg>
                </button>
            </div>
            <div class="hidden justify-between items-center w-full lg:flex lg:w-auto lg:order-1" id="mobile-menu-2">
                <ul class="flex flex-col mt-4 font-medium lg:flex-row lg:space-x-8 lg:mt-0">
                    <li>
                        <a n:href="Home:default"
                                {if isLinkCurrent('Home:default')}class="block py-2 pr-4 pl-3 text-white rounded bg-primary-700 lg:bg-transparent lg:text-primary-700 lg:p-0 dark:text-white"{else}class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"{/if}>Co & proč</a>
                    </li>
{*                    <li>*}
{*                        <a n:href="Home:default#why"*}
{*                                class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700">Proč</a>*}
{*                    </li>*}
                    <li>
                        <a n:href="Product:about"
                                {if isLinkCurrent('Product:about')}class="block py-2 pr-4 pl-3 text-white rounded bg-primary-700 lg:bg-transparent lg:text-primary-700 lg:p-0 dark:text-white"{else}class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"{/if}>Historie</a>
                    </li>
{*                    <li>*}
{*                        <a n:href="Product:default#faq"*}
{*                                class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700">Otázky</a>*}
{*                    </li>*}
                    <li>
                        <a href="#footer"
                           class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700">Kontakt</a>
                    </li>
                    <li>
                        <a n:href="Product:default" {if isLinkCurrent('Product:default')}class="block py-2 pr-4 pl-3 text-white rounded bg-primary-700 lg:bg-transparent lg:text-primary-700 lg:p-0 dark:text-white"{else}class="block py-2 pr-4 pl-3 text-gray-700 border-b border-gray-100 hover:bg-gray-50 lg:hover:bg-transparent lg:border-0 lg:hover:text-primary-700 lg:p-0 dark:text-gray-400 lg:dark:hover:text-white dark:hover:bg-gray-700 dark:hover:text-white lg:dark:hover:bg-transparent dark:border-gray-700"{/if}>Pásek original</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>
{include content}


<div n:foreach="$flashes as $flash" class="fixed z-50 inset-0 flex items-center justify-center bg-black bg-opacity-50"
                                    id="alert">
        <div class="absolute bg-gray-900 max-w-screen-xl mx-auto p-2 sm:p-4 rounded-lg shadow-lg w-full sm:w-auto">
            <div class="p-2 sm:p-3">
                <div class="flex items-center justify-between">
                    <div class="flex-1 flex items-center">
                        <p class="font-medium text-white">{$flash->message}</p>
                    </div>
                    <div class="ml-2">
                        <button type="button"
                                class="flex p-2 rounded-md hover-bg-gray-800 focus:outline-none focus-bg-gray-800"
                                aria-label="Hide banner" id="hide-button">
                            <svg class="h-6 w-6 text-white" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
</div>


<script>
    // Function to hide the alert
    function hideAlert() {
        const alert = document.getElementById('alert');
        if (alert) {
            alert.style.display = 'none';
        }
    }

    // Add a click event listener to the hide button
    let hideButton = document.getElementById('hide-button');
    if (hideButton)
        hideButton.addEventListener('click', hideAlert);

    // Set a timer to hide the alert after a certain time (e.g., 5000 milliseconds)
    setTimeout(hideAlert, 10000);
</script>




<footer class="p-4 bg-white md:p-8 lg:p-10 dark:bg-gray-800" id="footer">
        <div class="mx-auto max-w-screen-xl text-center">
            <a href="/"
               class="flex justify-center items-center text-2xl font-semibold text-gray-900 dark:text-white">
                Svítící kočárek
            </a>
            <p class="text-gray-500 dark:text-gray-400">Martin Lach</p>
            <p class="text-gray-500 dark:text-gray-400">ičo: 07402767 (nejsem plátce dph)</p>
            <p class="text-gray-500 dark:text-gray-400"><a href="mailto:chci@sviticikocarek.cz">chci@sviticikocarek.cz</a></p>
{*            <p class="text-gray-500 dark:text-gray-400">734530330</p>*}
{*            <p class="text-gray-500 dark:text-gray-400">Černá cesta 96/31, Olomouc 77900</p>*}
            <p class="my-6 text-gray-500 dark:text-gray-400">Protože odrazky nejsou cool.</p>
            <ul class="flex flex-wrap justify-center items-center mb-6 text-gray-900 dark:text-white">
                <li>
                    <a href="/uploads/vop.pdf" class="mr-4 hover:underline md:mr-6 " target="_blank">Obchodní podmínky</a>
                </li>
            </ul>

            <span class="text-sm text-gray-500 sm:text-center dark:text-gray-400">{date('Y')} - <a href="/"
                                                                                                   class="hover:underline">Svítící kočárek</a></span>
        </div>
</footer>
{block scripts}
    <script src="../dist/cookiesconsent.min.js"></script>
    <script>
        const header_content = "<h2>Nastavení cookies</h2><p>Můžete vybrat, které cookies nám povolíte využívat.</p>"

        // const footer_content = "<p>Lorem ipsum dolor sit amet consectetur adipiscing elit metus facilisis sociis, venenatis pretium quam cubilia feugiat erat luctus interdum sem, praesent massa magnis volutpat leo dui velit dis torquent.</p>"
        const cc = CookiesConsentJS({
            expirationDays: 365,
            position: "bottom",
            buttons: ["settings", "reject", "accept"],
            content: {
                title: "Důležité informace",
                message: "<h2>Informace o nákupu</h2><p>Plaba převodem, na základě platebních údajů poslaných e-mailem po objednání.<br> Zboží posíláme zásilkovnou.</p><h2>Používáme cookies!</h2><p>Díky nim můžeme analyzovat provoz webu, zlepšovat jeho funkce, výkon a použitelnost. Souhlasem nám umožníte využívat cookies od Google. <a href=\"https://policies.google.com/technologies/cookies\">Více informací</a></p>",
                // policy: "Privacy Policy",
                // policyLink: "https://gdpr-info.eu/",
                btnAccept: "Souhlasím s cookies",
                btnReject: "Odmítám cookies",
                btnSettings: "Nastavení cookies",
                btnSettingsSelectAll: "Vybrat vše",
                btnSettingsAccept: "Potvrdit výběr",
                settingsHeader: header_content,
                // settingsFooter: footer_content
            },
            cookies: {
                system: {
                    name: "system",
                    title: "Systémové cookies",
                    description: "<p>Nezbytné pro zobrazení webu.</p>",
                    checked: true,
                    disabled: true,
                },
                statistics: {
                    name: "analytics",
                    title: "Analytické cookies",
                    description: "<p>Pomáhají nám pochopit, jak web používáte. S jejich pomocí ho můžeme zlepšovat.</p>",
                },
                personalization: {
                    name: "personalization",
                    title: "Marketingové cookies",
                    description: "<p>Pomáhají s cílením reklamy.</p>",
                },
            },
            callback: {
                accept: "consentGranted",  // after clicking accept all and accept settings buttons
                reject: "consentRejected",  // after clicking reject all button
                load: "checkServices",  // every time the user accesses to the page (except the first time)
            }
        });

        function consentGranted() {
            gtag('consent', 'update', {
                'ad_storage': 'granted',
                'ad_user_data': 'granted',
                'ad_personalization': 'granted',
                'analytics_storage': 'granted'
            });
        }

        function consentRejected() {
            gtag('consent', 'update', {
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied',
                'analytics_storage': 'denied'
            });
        }

        function checkServices(params = "") {
            if (params.hasOwnProperty("analytics") && params.analytics)
                gtag('consent', 'update', {
                    'analytics_storage': 'granted'
                });
            else
                gtag('consent', 'update', {
                    'analytics_storage': 'denied'
                });

            if (params.hasOwnProperty("personalization") && params.personalization)
                gtag('consent', 'update', {
                    'ad_storage': 'granted',
                    'ad_user_data': 'granted',
                    'ad_personalization': 'granted',
                });
            else
                gtag('consent', 'update', {
                    'ad_storage': 'denied',
                    'ad_user_data': 'denied',
                    'ad_personalization': 'denied',
                });
        }

    </script>
    <script src="../node_modules\flowbite\dist/flowbite.min.js"></script>
    <script src="https://nette.github.io/resources/js/3/netteForms.min.js"></script>
{/block}
</body>
</html>
